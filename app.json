{
  "expo": {
    "name": "IMW App",
    "slug": "IMWApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imwapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#292929"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feijaoozin.IMWApp.ios"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#292929"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.feijaoozin.IMWApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.682310866995-7pd2rm3voeencufel9gdf0i2f390ilod"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5a4e42b6-a347-4f03-8e49-26de526db543"
      }
    }
  }
}
